rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Proposed PlayPrint namespace. No other app paths are granted access here.
    function signedIn() {
      return request.auth != null
        && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /apps/playprint/users/{uid} {
      allow read, write: if owner(uid);
      match /{privateDocument=**} {
        allow read, write: if owner(uid);
      }
    }

    // Public game catalog is maintained by trusted backend administrators.
    match /apps/playprint/games/{gameId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['id', 'name', 'searchName', 'createdBy'])
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.id is string
        && request.resource.data.id.size() <= 300
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 160
        && request.resource.data.searchName is string
        && request.resource.data.searchName.size() <= 160;
    }

    match /apps/playprint/profiles/{uid} {
      allow read: if true;
      allow create, update: if owner(uid)
        && request.resource.data.keys().hasOnly(['displayName', 'bio', 'avatarUrl', 'searchName', 'icon', 'color', 'iconColor', 'ringColor', 'favorites', 'reviewCount', 'artwork', 'reviewSummary'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.get('bio', '') is string
        && request.resource.data.get('bio', '').size() <= 80
        && request.resource.data.get('searchName', '') is string
        && request.resource.data.get('searchName', '').size() <= 80
        && request.resource.data.get('avatarUrl', '') is string
        && request.resource.data.get('avatarUrl', '').size() <= 150000
        && request.resource.data.get('artwork', '') is string
        && request.resource.data.get('artwork', '').size() <= 200000
        && request.resource.data.get('favorites', []) is list
        && request.resource.data.get('favorites', []).size() <= 8
        && request.resource.data.get('reviewSummary', []) is list
        && request.resource.data.get('reviewSummary', []).size() <= 100
        && request.resource.data.get('reviewCount', 0) is int
        && request.resource.data.get('reviewCount', 0) >= 0;
      allow delete: if owner(uid);
    }

    // One canonical edge per follower and followed account.
    match /apps/playprint/follows/{edgeId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['from', 'to', 'createdAt'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string
        && request.resource.data.to != request.auth.uid
        && edgeId == request.auth.uid + '_' + request.resource.data.to
        && exists(/databases/$(database)/documents/apps/playprint/profiles/$(request.resource.data.to))
        && request.resource.data.createdAt == request.time;
      allow delete: if owner(resource.data.from);
    }

    match /apps/playprint/activity/{postId} {
      allow read: if true;
      function validPost() {
        let d = request.resource.data;
        return d.keys().hasOnly(['authorId','displayName','icon','color','iconColor','ringColor','type','name','time','score','note','action','gameId'])
          && d.authorId == request.auth.uid
          && d.type in ['review','status']
          && d.name is string && d.name.size() <= 160
          && d.displayName is string && d.displayName.size() <= 80
          && d.time is number && d.time <= request.time.toMillis() + 300000
          && d.score is number && d.score >= 0 && d.score <= 102
          && d.note is string && d.note.size() <= 5000
          && d.action is string && d.action.size() <= 80
          && d.gameId is string && d.gameId.size() <= 300;
      }
      allow create: if signedIn() && validPost();
      allow update: if owner(resource.data.authorId) && validPost();
      allow delete: if owner(resource.data.authorId);
    }

    match /apps/playprint/reviews/{reviewId} {
      allow read: if true;
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update: if owner(resource.data.authorId)
        && request.resource.data.authorId == resource.data.authorId;
      allow delete: if owner(resource.data.authorId);

      match /likes/{uid} {
        allow read: if true;
        allow create: if owner(uid)
          && exists(/databases/$(database)/documents/apps/playprint/reviews/$(reviewId))
          && request.resource.data.keys().hasOnly(['createdAt'])
          && request.resource.data.createdAt == request.time;
        allow delete: if owner(uid);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && exists(/databases/$(database)/documents/apps/playprint/reviews/$(reviewId))
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.keys().hasOnly(['authorId', 'text', 'createdAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time;
        allow update: if owner(resource.data.authorId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow delete: if owner(resource.data.authorId);
      }
    }
    // All unmatched paths are denied by default.
    // If sharing a database, merge existing app rules before publishing.
  }
}
